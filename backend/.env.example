# ============================================================
# RKR RESTAURANT — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your credentials
# ============================================================

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Replace with your cluster URI: mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/rkr_restaurant?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rkr_restaurant?retryWrites=true&w=majority
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/rkr_restaurant

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration (Optional for order confirmation notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Payment Gateways (Sandbox Test Keys)
RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=your_stripe_secret_key

# Cloudinary (Optional for dynamic food photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
